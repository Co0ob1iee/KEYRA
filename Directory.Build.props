<Project>
  <!--
    Single source of truth for KEYRA product version (SemVer MAJOR.MINOR.PATCH).
    Bump with:  pwsh scripts/bump-version.ps1 -Part patch|minor|major
    Or edit Version / AssemblyVersion / FileVersion / InformationalVersion together.
  -->
  <PropertyGroup>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <!-- Keep InformationalVersion as plain SemVer (no +git SHA from the SDK). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>KEYRA</Product>
    <Company>KEYRA</Company>
    <Authors>KEYRA</Authors>
    <Copyright>Copyright (c) 2026 KEYRA contributors</Copyright>
    <Description>KEYRA — desktop SSH key vault and SSH client for Windows</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
