<UserControl x:Class="SshKeyManager.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SshKeyManager.Helpers"
             xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
             xmlns:loc="clr-namespace:SshKeyManager.Localization"
             xmlns:vm="clr-namespace:SshKeyManager.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource MarginSubsectionBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Saved profiles -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusXl}"
                    Padding="{StaticResource Space12Thickness}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource MarginSubsectionBottom}">
                        <TextBlock Text="{Binding ProfilesLabel}" Style="{StaticResource LabelTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding NewProfileLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,4"
                                    Command="{Binding NewProfileCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="{Binding DeleteProfileLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,4"
                                    Command="{Binding DeleteProfileCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="8"
                                    Visibility="{Binding HasProfiles, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding EmptyProfilesTitle}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextAlignment="Center"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding EmptyProfilesMessage}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding SavedProfiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusMd}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionHighlightBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectionProfileItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FavoriteGlyph}"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0"
                                                   Width="16"
                                                   TextAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding HostPort}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Username, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding LastUsedText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Ad-hoc / profile form -->
            <StackPanel Grid.Column="2" MaxWidth="760" HorizontalAlignment="Left">
                <controls:SectionHeader Title="{Binding Title}" />

                <Grid Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,8">
                        <TextBlock Text="{Binding ProfileNameLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" VerticalAlignment="Bottom">
                        <CheckBox Content="{Binding FavoriteLabel}"
                                  IsChecked="{Binding IsFavorite}"
                                  Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                        <TextBlock Text="{Binding HostLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                        <TextBlock Text="{Binding PortLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{Binding UsernameLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <CheckBox Content="{Binding PasswordAuthLabel}"
                                  IsChecked="{Binding UsePasswordAuth}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding UsePasswordAuth, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding SshPasswordLabel}" Style="{StaticResource LabelTextStyle}" />
                            <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding PasswordNotSavedHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding UsePasswordAuth, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding VaultKeyLabel}" Style="{StaticResource LabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableKeys}"
                                      SelectedItem="{Binding SelectedKey}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,8" />
                            <TextBlock Text="{Binding KeyPassphraseLabel}" Style="{StaticResource LabelTextStyle}" />
                            <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding KeyPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Text="{Binding JumpHostLabel}" Style="{StaticResource LabelTextStyle}" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding JumpHostChoices}"
                                  SelectedItem="{Binding SelectedJumpHost}"
                                  Margin="0,0,0,4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding DataContext.JumpHostNoneLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding JumpHostHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding SaveProfileLabel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SaveProfileCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding SaveAsProfileLabel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SaveAsProfileCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding FavoriteLabel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Margin="0,0,8,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ActiveSessionCountLabel}"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button Content="{Binding ConnectLabel}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConnectCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding DisconnectLabel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DisconnectAllCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Active sessions -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusXl}"
                Padding="12"
                Margin="{StaticResource Space8Thickness}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ActiveSessionsLabel}"
                               Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding FocusSessionLabel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                Command="{Binding FocusSelectedCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding DisconnectLabel}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="10,4"
                                Command="{Binding DisconnectSelectedCommand}" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16"
                                Visibility="{Binding HasActiveSessions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding EmptySessionsTitle}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding EmptySessionsMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding ActiveSessions}"
                             SelectedItem="{Binding SelectedActiveSession}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasActiveSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionHighlightBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActiveSshSessionItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding HostSummary}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <Button Content="{Binding DataContext.FocusSessionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,4"
                                                Command="{Binding FocusCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{Binding DataContext.DisconnectLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,4"
                                                Command="{Binding DisconnectCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <controls:LoadingOverlay Grid.RowSpan="2"
                                 IsBusy="{Binding IsBusy}"
                                 Message="{loc:Loc Key=Loading_PleaseWait}" />
    </Grid>
</UserControl>
