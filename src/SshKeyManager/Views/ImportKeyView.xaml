<UserControl x:Class="SshKeyManager.Views.ImportKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
             xmlns:helpers="clr-namespace:SshKeyManager.Helpers"
             xmlns:loc="clr-namespace:SshKeyManager.Localization">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <controls:SectionHeader Title="{Binding Title}" />

                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding NameLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="{StaticResource MarginFieldBottom}" />

                        <DockPanel Margin="{StaticResource MarginSubsectionBottom}">
                            <TextBlock Text="{Binding PrivateKeyLabel}"
                                       Style="{StaticResource LabelTextStyle}"
                                       VerticalAlignment="Center" />
                            <Button Content="{Binding BrowseLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding BrowseCommand}" />
                        </DockPanel>
                        <TextBox Text="{Binding PrivateKeyPem, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="180"
                                 FontFamily="Consolas"
                                 FontSize="{StaticResource FontSizeBody}"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="{StaticResource MarginFieldBottom}" />

                        <TextBlock Text="{Binding PassphraseLabel}" Style="{StaticResource LabelTextStyle}" />
                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Passphrase, Mode=TwoWay}"
                                     Margin="{StaticResource MarginSubsectionBottom}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginFormCard}">
                    <Button Content="{Binding PreviewLabel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,12,0"
                            Command="{Binding PreviewCommand}" />
                    <Button Content="{Binding ImportButtonLabel}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ImportCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource MarginFormCard}" />

                <Border Style="{StaticResource FormCardStyle}"
                        Visibility="{Binding PreviewFingerprint, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FingerprintLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding PreviewFingerprint, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 Margin="{StaticResource MarginFieldBottom}" />

                        <TextBlock Text="{Binding PublicKeyLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding PreviewPublicKey, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Height="90"
                                 FontFamily="Consolas"
                                 FontSize="{StaticResource FontSizeMono}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay IsBusy="{Binding IsBusy}"
                                 Message="{loc:Loc Key=Loading_PleaseWait}" />
    </Grid>
</UserControl>
