<UserControl x:Class="SshKeyManager.Views.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30"
             MinHeight="28"
             MaxHeight="32"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Background="{StaticResource StatusBarBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,0">
        <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                <Ellipse Style="{StaticResource StatusDotStyle}"
                         Fill="{Binding ConnectionBrush}"
                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280" />
                <TextBlock Text="│"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="10,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding SectionLabel}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="│"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="10,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConnectionLabel}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="│"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="10,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding KeyCountLabel}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="│"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="10,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding VaultStateLabel}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding AppVersion}"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right"
                       Margin="8,0,0,0" />
        </DockPanel>
    </Border>
</UserControl>
