<UserControl x:Class="SshKeyManager.Views.Controls.AuthCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Style="{StaticResource AuthCardStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ClipToBounds="True">
        <Grid>
            <StackPanel>
                <Border Width="56"
                        Height="56"
                        CornerRadius="12"
                        ClipToBounds="True"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/keyra-logo.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource SectionTitleStyle}"
                           FontSize="{StaticResource FontSizeTitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <ContentPresenter Content="{Binding FormContent, ElementName=Root}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>

                <TextBlock Text="{Binding ErrorMessage, ElementName=Root}"
                           Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button x:Name="SecondaryButton"
                            Content="{Binding SecondaryButtonContent, ElementName=Root}"
                            Margin="0,0,12,0"
                            IsCancel="True"
                            Command="{Binding SecondaryButtonCommand, ElementName=Root}"
                            Click="SecondaryButton_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SecondaryButtonContent, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding PrimaryButtonContent, ElementName=Root}"
                            Command="{Binding PrimaryButtonCommand, ElementName=Root}"
                            IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <controls:LoadingOverlay IsBusy="{Binding IsBusy, ElementName=Root}"
                                     Message="{Binding BusyMessage, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
