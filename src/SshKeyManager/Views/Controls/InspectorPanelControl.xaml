<UserControl x:Class="SshKeyManager.Views.Controls.InspectorPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1,0,0,0"
            Padding="{StaticResource Space16Thickness}"
            Style="{StaticResource PanelSlideInStyle}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Title}"
                       Style="{StaticResource SubsectionTitleStyle}"
                       Margin="0,0,0,8" />

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding SelectKey}"
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,0,0,12"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <TabControl Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem Header="{Binding TabDetails}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding NameLabel}" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock Text="{Binding SelectedRecord.Name}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="{Binding AlgorithmLabel}" Style="{StaticResource LabelTextStyle}" />
                            <Border Style="{StaticResource BadgeStyle}" Margin="0,0,0,16">
                                <TextBlock Text="{Binding AlgorithmDisplay}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>

                            <TextBlock Text="{Binding FingerprintLabel}" Style="{StaticResource LabelTextStyle}" />
                            <TextBox Text="{Binding SelectedRecord.Fingerprint, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,16" />

                            <TextBlock Text="{Binding CommentLabel}" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock Text="{Binding SelectedRecord.Comment}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="{Binding PublicKeyLabel}" Style="{StaticResource LabelTextStyle}" />
                            <TextBox Text="{Binding SelectedRecord.PublicKey, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Height="90"
                                     FontFamily="Consolas"
                                     FontSize="{StaticResource FontSizeMono}"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,16" />

                            <TextBlock Text="{Binding VaultPathLabel}" Style="{StaticResource LabelTextStyle}" />
                            <TextBox Text="{Binding VaultPathDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     FontSize="{StaticResource FontSizeMono}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding TabActions}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <Button Content="{Binding CopyPublicKeyLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CopyPublicKeyCommand}" />
                            <Button Content="{Binding ShowPrivateKeyLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RevealPrivateKeyCommand}" />
                            <Button Content="{Binding CopyPrivateKeyLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CopyPrivateKeyCommand}" />
                            <Button Content="{Binding ExportFolderLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ExportFolderCommand}" />
                            <Button Content="{Binding ExportSshLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ExportToSshCommand}" />
                            <Button Content="{Binding DeleteLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteKeyCommand}" />

                            <Border Style="{StaticResource FormCardStyle}"
                                    Padding="{StaticResource Space12Thickness}"
                                    Margin="0"
                                    Visibility="{Binding IsPrivateKeyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding PrivateKeyLabel}"
                                                   Style="{StaticResource LabelTextStyle}"
                                                   DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding RevealCountdownText}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="{StaticResource FontSizeMono}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBox Text="{Binding RevealedPrivateKey, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Height="140"
                                             FontFamily="Consolas"
                                             FontSize="{StaticResource FontSizeMono}"
                                             VerticalScrollBarVisibility="Auto" />
                                    <Button Content="{Binding HideNowLabel}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding HidePrivateKeyCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
