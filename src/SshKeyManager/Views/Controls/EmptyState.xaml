<UserControl x:Class="SshKeyManager.Views.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="{StaticResource Space32Thickness}">
        <Border Width="48"
                Height="48"
                CornerRadius="10"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Opacity="0.85"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1">
            <Image Source="pack://application:,,,/Assets/keyra-logo.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource SubsectionTitleStyle}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0" />
        <TextBlock Text="{Binding Message, ElementName=Root}"
                   Style="{StaticResource MutedTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="420"
                   Margin="{StaticResource Space8Thickness}" />
    </StackPanel>
</UserControl>
