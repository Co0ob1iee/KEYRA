<UserControl x:Class="SshKeyManager.Views.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Margin="{StaticResource MarginSectionBottom}">
    <DockPanel LastChildFill="True">
        <ContentPresenter x:Name="ActionSlot"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Content="{Binding ActionContent, ElementName=Root}" />

        <Button x:Name="ActionButton"
                DockPanel.Dock="Right"
                Content="{Binding ActionLabel, ElementName=Root}"
                Command="{Binding ActionCommand, ElementName=Root}"
                Style="{StaticResource SecondaryButtonStyle}"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Visibility="Collapsed" />

        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </DockPanel>
</UserControl>
