<UserControl x:Class="SshKeyManager.Views.Controls.TerminalInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinHeight="32"
             Focusable="False">
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="28" />
        </Grid.RowDefinitions>

        <!-- Thin top rule so the input line reads as part of the terminal surface -->
        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource InputBackgroundBrush}"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False" />

        <Grid Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="›"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="4,0,6,0"
                       IsHitTestVisible="False" />

            <Grid Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="28">
                <TextBlock x:Name="GhostOverlay"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="13"
                           Margin="0,6"
                           IsHitTestVisible="False"
                           Visibility="Collapsed">
                    <Run x:Name="GhostPrefixRun" Foreground="Transparent" />
                    <Run x:Name="GhostSuffixRun" Foreground="{StaticResource GhostTextBrush}" />
                </TextBlock>

                <!-- Override app-wide InputStyle template so this stays a flat console line -->
                <TextBox x:Name="InputBox"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         MinHeight="28"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         Padding="0,6"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource AccentBrush}"
                         SelectionBrush="{StaticResource AccentBrush}"
                         IsEnabled="{Binding IsTerminalInputEnabled}"
                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         TextChanged="InputBox_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          Focusable="False"
                                                          VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Grid>

        <Popup x:Name="SuggestionPopup"
               PlacementTarget="{Binding ElementName=Root}"
               Placement="Top"
               VerticalOffset="-4"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsSuggestionPopupOpen, Mode=TwoWay}"
               PopupAnimation="None"
               Opened="SuggestionPopup_Opened">
            <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                    MaxHeight="220"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen, ElementName=SuggestionPopup}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource TerminalPopupFadeInStoryboard}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListBox x:Name="SuggestionList"
                         ItemsSource="{Binding FilteredSuggestions}"
                         SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="SuggestionList_PreviewKeyDown"
                         MouseDoubleClick="SuggestionList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionHighlightBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
