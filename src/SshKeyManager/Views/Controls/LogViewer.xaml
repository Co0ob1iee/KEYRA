<UserControl x:Class="SshKeyManager.Views.Controls.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SshKeyManager.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="8,4,8,8"
                    HorizontalAlignment="Left">
            <TextBlock Text="{Binding FilterLabel}"
                       Style="{StaticResource LabelTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding FilterLevels}"
                      SelectedItem="{Binding SelectedFilterLevel}"
                      Width="120"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="240"
                     MaxWidth="280"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     ToolTip="{Binding SearchLabel}" />
        </StackPanel>

        <ListBox x:Name="LogList"
                 Grid.Row="1"
                 ItemsSource="{Binding FilteredEntries}"
                 Style="{StaticResource TransparentListBoxStyle}"
                 Margin="8,0,8,8"
                 FontFamily="{StaticResource MonoFontFamily}"
                 FontSize="{StaticResource FontSizeCaption}"
                 ScrollViewer.ScrollChanged="LogList_ScrollChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:AppLogEntry}">
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource LogInfoBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                        <Setter Property="Foreground" Value="{StaticResource LogWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                        <Setter Property="Foreground" Value="{StaticResource LogErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
