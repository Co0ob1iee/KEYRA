<UserControl x:Class="SshKeyManager.Views.Controls.KeyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="300"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <UniformGrid DockPanel.Dock="Bottom" Columns="3">
                <Button Content="{Binding CopyLabel, ElementName=Root}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource Space4Thickness}"
                        Padding="{StaticResource PaddingSm}"
                        FontSize="{StaticResource FontSizeMono}"
                        Command="{Binding CopyCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                <Button Content="{Binding ExportLabel, ElementName=Root}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource Space4Thickness}"
                        Padding="{StaticResource PaddingSm}"
                        FontSize="{StaticResource FontSizeMono}"
                        Command="{Binding ExportCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                <Button Content="{Binding DeleteLabel, ElementName=Root}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource Space4Thickness}"
                        Padding="{StaticResource PaddingSm}"
                        FontSize="{StaticResource FontSizeMono}"
                        Command="{Binding DeleteCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
            </UniformGrid>

            <Button Command="{Binding SelectKeyCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Background="{StaticResource TransparentBrush}"
                    BorderThickness="0"
                    Padding="0"
                    Margin="{StaticResource MarginSubsectionBottom}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <DockPanel Margin="{StaticResource MarginSubsectionBottom}">
                        <Border Style="{StaticResource BadgeStyle}"
                                DockPanel.Dock="Right"
                                Margin="{StaticResource Space8Thickness}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlgorithmLabel}"
                                       FontSize="{StaticResource FontSizeMono}"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{StaticResource FontSizeSection}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Fingerprint}"
                               Style="{StaticResource MutedTextStyle}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource FontSizeMono}"
                               Margin="{StaticResource MarginSubsectionBottom}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Comment}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource Space4Thickness}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CreatedLocal}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="{StaticResource Space4Thickness}" />
                    <TextBlock Text="{Binding PassphraseLabel}"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Border>
</UserControl>
