<UserControl x:Class="SshKeyManager.Views.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
             xmlns:models="clr-namespace:SshKeyManager.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0">
        <DockPanel Margin="0,16,0,16">
            <StackPanel DockPanel.Dock="Top" Margin="20,8,20,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/keyra-logo.png"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{Binding Navigation.AppTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="{Binding Navigation.LockVaultLabel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,16,0,0"
                        Padding="10,6"
                        HorizontalAlignment="Stretch"
                        Command="{Binding LockAndExitCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Navigation.NavigationItems}"
                          DockPanel.Dock="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NavigationItem}">
                        <controls:NavigationItemControl
                            NavigateCommand="{Binding DataContext.Navigation.NavigateCommand, RelativeSource={RelativeSource AncestorType=controls:SidebarControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
