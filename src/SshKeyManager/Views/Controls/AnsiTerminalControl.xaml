<UserControl x:Class="SshKeyManager.Views.Controls.AnsiTerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <RichTextBox x:Name="OutputBox"
                 IsReadOnly="True"
                 IsUndoEnabled="False"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="{StaticResource InputBackgroundBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 CaretBrush="{StaticResource AccentBrush}"
                 SelectionBrush="{StaticResource AccentBrush}"
                 FontFamily="{StaticResource MonoFontFamily}"
                 FontSize="{StaticResource FontSizeBody}"
                 Padding="4">
        <RichTextBox.Resources>
            <Style TargetType="{x:Type Paragraph}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="LineHeight" Value="18" />
            </Style>
        </RichTextBox.Resources>
        <FlowDocument x:Name="Document"
                      PagePadding="0"
                      TextAlignment="Left" />
    </RichTextBox>
</UserControl>
