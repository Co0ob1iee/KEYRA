<UserControl x:Class="SshKeyManager.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             x:Name="Root"
             Height="36"
             Background="{StaticResource SurfaceBrush}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0"
                        IsHitTestVisible="False">
                <Border Width="22"
                        Height="22"
                        CornerRadius="4"
                        ClipToBounds="True"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource BackgroundBrush}">
                    <Image Source="pack://application:,,,/Assets/keyra-logo.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KEY" Style="{StaticResource BrandKeyStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="RA" Style="{StaticResource BrandRaStyle}" VerticalAlignment="Center" Margin="1,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Content="─"
                        ToolTip="Minimize"
                        Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding ShowMinimizeButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Content="☐"
                        ToolTip="Maximize"
                        Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding ShowMaximizeButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource CaptionCloseButtonStyle}"
                        Content="✕"
                        ToolTip="Close"
                        Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding ShowCloseButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
