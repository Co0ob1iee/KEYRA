<UserControl x:Class="SshKeyManager.Views.GenerateKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
             xmlns:helpers="clr-namespace:SshKeyManager.Helpers"
             xmlns:models="clr-namespace:SshKeyManager.Models">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <controls:SectionHeader Title="{Binding Title}" />

                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding NameLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="{StaticResource MarginFieldBottom}" />

                        <TextBlock Text="{Binding CommentLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="{StaticResource MarginFieldBottom}" />

                        <TextBlock Text="{Binding AlgorithmLabel}" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding Algorithms}"
                                  SelectedItem="{Binding SelectedAlgorithm}"
                                  Margin="{StaticResource MarginFieldBottom}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SshKeyAlgorithm}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:SshKeyAlgorithm.Ed25519}">
                                                        <Setter Property="Text" Value="{Binding DataContext.Ed25519Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:SshKeyAlgorithm.Rsa4096}">
                                                        <Setter Property="Text" Value="{Binding DataContext.Rsa4096Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding PassphraseLabel}" Style="{StaticResource LabelTextStyle}" />
                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Passphrase, Mode=TwoWay}"
                                     Margin="{StaticResource MarginFieldBottom}" />

                        <TextBlock Text="{Binding ConfirmPassphraseLabel}" Style="{StaticResource LabelTextStyle}" />
                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding PassphraseConfirm, Mode=TwoWay}"
                                     Margin="{StaticResource MarginSubsectionBottom}" />
                    </StackPanel>
                </Border>

                <Button Content="{Binding GenerateButtonLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        MinWidth="160"
                        Command="{Binding GenerateCommand}" />

                <TextBlock Text="{Binding ResultMessage}"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,16,0,0"
                           Foreground="{StaticResource SuccessBrush}" />

                <Border Style="{StaticResource FormCardStyle}"
                        Margin="0,16,0,0"
                        Visibility="{Binding LastFingerprint, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FingerprintLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding LastFingerprint, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 Margin="{StaticResource MarginFieldBottom}" />

                        <TextBlock Text="{Binding PublicKeyLabel}" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding LastPublicKey, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Height="90"
                                 FontFamily="Consolas"
                                 FontSize="{StaticResource FontSizeMono}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay IsBusy="{Binding IsBusy}"
                                 Message="{Binding BusyLabel}" />
    </Grid>
</UserControl>
