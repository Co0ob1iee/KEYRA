<Window x:Class="SshKeyManager.Views.SshSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
        xmlns:loc="clr-namespace:SshKeyManager.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/keyra-icon.ico"
        MinWidth="720"
        MinHeight="480"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="Window_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0"
                                      Title="{Binding WindowTitle}"
                                      ShowMinimizeButton="True"
                                      ShowMaximizeButton="True"
                                      ShowCloseButton="True" />

            <Grid Grid.Row="1" Margin="12">
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="{StaticResource Space8Thickness}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionLabel}"
                                           Style="{StaticResource LabelTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding ConnectionStatus}"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding ClearLabel}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        Command="{Binding ClearOutputCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="{Binding DisconnectLabel}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="10,4"
                                        Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Full-width console input flush under scrollback (Enter sends) -->
                        <controls:TerminalInputControl x:Name="SessionCommandInput"
                                                       DockPanel.Dock="Bottom"
                                                       HorizontalAlignment="Stretch"
                                                       Margin="0,4,0,0" />

                        <controls:AnsiTerminalControl x:Name="SessionTerminal"
                                                      AnsiText="{Binding SessionOutput, Mode=OneWay}"
                                                      RequestInputFocus="SessionTerminal_RequestInputFocus" />
                    </DockPanel>
                </Border>

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}"
                                         Message="{loc:Loc Key=Loading_PleaseWait}" />
            </Grid>
        </Grid>
    </Border>
</Window>
