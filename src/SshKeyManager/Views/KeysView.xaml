<UserControl x:Class="SshKeyManager.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
             xmlns:loc="clr-namespace:SshKeyManager.Localization"
             xmlns:vm="clr-namespace:SshKeyManager.ViewModels"
             xmlns:views="clr-namespace:SshKeyManager.Views">
    <Grid>
        <DockPanel>
            <controls:SectionHeader DockPanel.Dock="Top"
                                    Title="{Binding Title}"
                                    ActionLabel="{Binding RefreshLabel}"
                                    ActionCommand="{Binding RefreshCommand}" />

            <StackPanel DockPanel.Dock="Top" Margin="{StaticResource MarginFormCard}">
                <TextBlock Text="{Binding SearchWatermark}" Style="{StaticResource LabelTextStyle}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid>
                <controls:EmptyState Title="{loc:Loc Key=Empty_NoKeysTitle}"
                                     Message="{loc:Loc Key=Empty_NoKeysMessage}"
                                     Visibility="{Binding HasKeys, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasKeys, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding FilteredKeys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeyListItemViewModel}">
                                <controls:KeyCard SelectKeyCommand="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=views:KeysView}}"
                                                  CopyCommand="{Binding DataContext.CopyPublicKeyCommand, RelativeSource={RelativeSource AncestorType=views:KeysView}}"
                                                  ExportCommand="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=views:KeysView}}"
                                                  DeleteCommand="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=views:KeysView}}"
                                                  CopyLabel="{Binding DataContext.CopyPubLabel, RelativeSource={RelativeSource AncestorType=views:KeysView}}"
                                                  ExportLabel="{Binding DataContext.ExportLabel, RelativeSource={RelativeSource AncestorType=views:KeysView}}"
                                                  DeleteLabel="{Binding DataContext.DeleteLabel, RelativeSource={RelativeSource AncestorType=views:KeysView}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <controls:LoadingOverlay IsBusy="{Binding IsBusy}"
                                 Message="{loc:Loc Key=Loading_PleaseWait}" />
    </Grid>
</UserControl>
