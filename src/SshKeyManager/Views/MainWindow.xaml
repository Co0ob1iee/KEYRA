<Window x:Class="SshKeyManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SshKeyManager.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding AppTitle}"
        Icon="pack://application:,,,/Assets/keyra-icon.ico"
        Width="1280"
        MinWidth="1280"
        MaxWidth="1280"
        MinHeight="720"
        Height="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding LogRowHeight, Mode=TwoWay}" MinHeight="28" MaxHeight="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0"
                                      Title="{Binding AppTitle}"
                                      ShowMinimizeButton="True"
                                      ShowMaximizeButton="False"
                                      ShowCloseButton="True" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:SidebarControl Grid.Column="0"
                                         DataContext="{Binding}" />

                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundBrush}"
                        Padding="{StaticResource Space24Thickness}"
                        Style="{StaticResource FadeInOnLoadStyle}">
                    <ContentControl Content="{Binding CurrentViewModel}"
                                    Style="{StaticResource SmoothNavigationContentStyle}" />
                </Border>

                <controls:InspectorPanelControl Grid.Column="2"
                                                Width="320"
                                                MinWidth="240"
                                                MaxWidth="480"
                                                DataContext="{Binding Inspector}" />
            </Grid>

            <GridSplitter Grid.Row="2"
                          Style="{StaticResource GridSplitterStyle}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />

            <controls:LogPanelControl Grid.Row="3"
                                      DataContext="{Binding LogPanel}" />

            <controls:StatusBarControl Grid.Row="4"
                                       DataContext="{Binding StatusBar}" />
        </Grid>
    </Border>
</Window>
