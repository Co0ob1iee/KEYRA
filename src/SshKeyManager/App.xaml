<Application x:Class="SshKeyManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SshKeyManager.Converters"
             xmlns:vm="clr-namespace:SshKeyManager.ViewModels"
             xmlns:views="clr-namespace:SshKeyManager.Views">

    <Application.Resources>
        <ResourceDictionary>
            <!--
              Merge order is dependency-first. Spacing before Typography (margins).
              Shadows after Colors (AccentColor/ShadowColor). Style dictionaries after tokens.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="Resources/Themes/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Themes/Borders.xaml" />
                <ResourceDictionary Source="Resources/Themes/Shadows.xaml" />
                <ResourceDictionary Source="Resources/Themes/Typography.xaml" />
                <ResourceDictionary Source="Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="Resources/Themes/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Themes/Inputs.xaml" />
                <ResourceDictionary Source="Resources/Themes/Cards.xaml" />
                <ResourceDictionary Source="Resources/Themes/Navigation.xaml" />
                <ResourceDictionary Source="Resources/Themes/Animations.xaml" />
                <ResourceDictionary Source="Resources/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:KeysViewModel}">
                <views:KeysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GenerateKeyViewModel}">
                <views:GenerateKeyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportKeyViewModel}">
                <views:ImportKeyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}">
                <views:ConnectionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
