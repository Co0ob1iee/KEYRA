<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\keyra-icon.ico</ApplicationIcon>
    <AssemblyTitle>KEYRA</AssemblyTitle>
    <AssemblyName>SshKeyManager</AssemblyName>
    <RootNamespace>SshKeyManager</RootNamespace>
    <!-- Version / AssemblyVersion / FileVersion / InformationalVersion: Directory.Build.props -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Locales\*.locale.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\keyra-icon.ico" />
    <Resource Include="Assets\keyra-logo.png" />
    <Resource Include="Assets\Fonts\Inter-Regular.otf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.otf" />
    <Resource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />
    <None Include="Assets\keyra-icon.jpg" />
  </ItemGroup>

</Project>
