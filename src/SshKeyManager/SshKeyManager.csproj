<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\keyra-icon.ico</ApplicationIcon>
    <AssemblyTitle>KEYRA</AssemblyTitle>
    <Product>KEYRA</Product>
    <AssemblyName>SshKeyManager</AssemblyName>
    <RootNamespace>SshKeyManager</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>KEYRA</Company>
    <Authors>KEYRA</Authors>
    <Description>KEYRA — desktop SSH key vault and SSH client for Windows</Description>
    <Copyright>Copyright (c) 2026 KEYRA contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Locales\*.locale.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\keyra-icon.ico" />
    <Resource Include="Assets\keyra-logo.png" />
    <None Include="Assets\keyra-icon.jpg" />
  </ItemGroup>

</Project>
