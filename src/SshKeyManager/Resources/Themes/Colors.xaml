<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base surfaces — Deep Slate / Card Dark family -->
    <Color x:Key="BackgroundColor">#0B0F19</Color>
    <Color x:Key="SurfaceColor">#161B22</Color>
    <Color x:Key="HoverSurfaceColor">#1F2633</Color>
    <Color x:Key="InputBackgroundColor">#0B0F19</Color>
    <Color x:Key="PressedSurfaceColor">#12171F</Color>
    <Color x:Key="SelectionHighlightColor">#0D2A24</Color>
    <Color x:Key="StatusBarBackgroundColor">#12171F</Color>
    <Color x:Key="SkeletonColor">#21262D</Color>

    <!-- Accents & feedback — Cyber Emerald / Electric Blue / Crimson -->
    <Color x:Key="AccentColor">#10B981</Color>
    <Color x:Key="AccentHoverColor">#34D399</Color>
    <Color x:Key="AccentPressedColor">#059669</Color>
    <Color x:Key="AccentOnColor">#0B0F19</Color>
    <Color x:Key="SecondaryAccentColor">#3B82F6</Color>
    <Color x:Key="SecondaryAccentHoverColor">#60A5FA</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorPressedColor">#DC2626</Color>

    <!-- Text — Off-White / Muted Gray -->
    <Color x:Key="TextPrimaryColor">#F3F4F6</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="GhostTextColor">#6B7280</Color>

    <!-- Borders / overlays (harmonized with Card Dark) -->
    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="BorderSubtleColor">#21262D</Color>
    <Color x:Key="OverlayScrimColor">#CC0B0F19</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="LogInfoColor">#3B82F6</Color>
    <Color x:Key="LogWarningColor">#F59E0B</Color>
    <Color x:Key="LogErrorColor">#EF4444</Color>

    <!-- Brush tokens -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="{StaticResource PressedSurfaceColor}" />
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="{StaticResource SelectionHighlightColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="{StaticResource AccentOnColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4010B981" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="{StaticResource SecondaryAccentHoverColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorPressedBrush" Color="{StaticResource ErrorPressedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="GhostTextBrush" Color="{StaticResource GhostTextColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="{StaticResource OverlayScrimColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <SolidColorBrush x:Key="LogInfoBrush" Color="{StaticResource LogInfoColor}" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="{StaticResource LogWarningColor}" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="{StaticResource LogErrorColor}" />

</ResourceDictionary>
