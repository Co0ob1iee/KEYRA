<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Borders.xaml" />
        <ResourceDictionary Source="Shadows.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Terminal suggestion popup fade (150 ms) -->
    <Storyboard x:Key="TerminalPopupFadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0"
                         To="1"
                         Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Fade In (200 ms) -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0"
                         To="1"
                         Duration="0:0:0.2" />
    </Storyboard>

    <!-- Fade Out (180 ms) -->
    <Storyboard x:Key="FadeOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1"
                         To="0"
                         Duration="0:0:0.18" />
    </Storyboard>

    <!-- Panel Slide from right (220 ms) -->
    <Storyboard x:Key="PanelSlideInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="24"
                         To="0"
                         Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0"
                         To="1"
                         Duration="0:0:0.2" />
    </Storyboard>

    <!-- Smooth Navigation opacity pulse (200 ms) -->
    <Storyboard x:Key="SmoothNavigationStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.55"
                         To="1"
                         Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Loading Skeleton shimmer (250 ms loop) -->
    <Storyboard x:Key="LoadingSkeletonStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.35"
                         To="0.85"
                         Duration="0:0:0.25"
                         AutoReverse="True" />
    </Storyboard>

    <!-- Apply FadeIn on Loaded -->
    <Style x:Key="FadeInOnLoadStyle" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hover Glow on Border (Accent glow, 150–200 ms) -->
    <Style x:Key="HoverGlowBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                <Setter Property="Effect" Value="{StaticResource HoverGlowShadow}" />
            </Trigger>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         Duration="0:0:0.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Skeleton placeholder block -->
    <Style x:Key="LoadingSkeletonStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkeletonBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Opacity" Value="0.5" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard Storyboard="{StaticResource LoadingSkeletonStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Panel with slide-in transform -->
    <Style x:Key="PanelSlideInStyle" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="24" Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PanelSlideInStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Smooth navigation on ContentControl content change -->
    <Style x:Key="SmoothNavigationContentStyle" TargetType="ContentControl">
        <Setter Property="Opacity" Value="1" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="ContentControl.Loaded">
                <BeginStoryboard Storyboard="{StaticResource SmoothNavigationStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
